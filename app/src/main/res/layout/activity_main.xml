<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_void">

    <!-- 1080p Landscape Background -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_background_photo"
        android:scaleType="centerCrop"
        android:src="@drawable/img_default_landscape" />

    <!-- Subtle Dark Scrim for High Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_overlay" />

    <!-- Main Launcher Workspace -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingTop="28dp"
        android:paddingEnd="44dp"
        android:paddingBottom="24dp">

        <!-- Top Thin Navigation & Status Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHomeHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.02"
                android:text="@string/nav_brand_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_top_pill"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/tv_status_amber"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Top-Right Order: Network Icon -> Weather -> Clock -> Settings Gear -->
            <LinearLayout
                android:id="@+id/topRightControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivNetworkIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@string/cd_network_status"
                    android:src="@drawable/ic_wifi_on" />

                <LinearLayout
                    android:id="@+id/weatherContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_top_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:nextFocusDown="@+id/rvMainCards"
                    android:nextFocusRight="@+id/btnSettings"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/ivWeatherIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_weather_sun" />

                    <TextView
                        android:id="@+id/tvWeatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="@string/weather_loading"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="12:00"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_top_pill"
                    android:contentDescription="@string/cd_settings_gear"
                    android:focusable="true"
                    android:nextFocusDown="@+id/rvMainCards"
                    android:nextFocusLeft="@+id/weatherContainer"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings_gear" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary Horizontal Card Row -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMainCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:nextFocusUp="@+id/btnSettings"
            android:overScrollMode="never" />

        <!-- Contextual YouTube Latest Videos Strip (shown when YouTube card is focused) -->
        <LinearLayout
            android:id="@+id/youtubeRowContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvYoutubeHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/section_youtube_videos"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvYoutubeSourceBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvYoutubeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/youtube_loading"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvYoutubeVideos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@+id/rvMainCards"
                android:overScrollMode="never" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_hint_dpads"
            android:textColor="@color/tv_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Burn-in Safe OLED Clock Screensaver Overlay -->
    <FrameLayout
        android:id="@+id/screensaverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/screensaverClockBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvSaverTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="12:00"
                android:textColor="#FFE2E8F0"
                android:textSize="76sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSaverDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:textColor="#FF94A3B8"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvSaverWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFBBF24"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSaverHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/screensaver_hint"
                android:textColor="#FF475569"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
