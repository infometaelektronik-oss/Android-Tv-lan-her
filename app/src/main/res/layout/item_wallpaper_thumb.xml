<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_tv_video_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/ivWallpaperThumb"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="#FF111827"
        android:contentDescription="@string/cd_background_photo"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvWallpaperTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tv_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
