<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SadeTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/tv_bg_void</item>
        <item name="android:colorBackground">@color/tv_bg_void</item>
        <item name="android:colorPrimary">@color/tv_focus_accent</item>
        <item name="android:textColorPrimary">@color/tv_text_primary</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Theme.SadeTV.Fullscreen" parent="Theme.SadeTV">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="SadeTvDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
</resources>
